# ============================================================
# Data & experiment artifacts
# ============================================================
# CIFAR-100 raw data (~339 MB, re-downloadable)
data/

# Experiment outputs: keep result metadata (config.json, metrics.csv,
# summaries) but exclude images and model weights.
# task_a/runs/ is ~2.1 GB, almost entirely *.pt checkpoints and *.png curves.
task_a/runs/**/*.png
task_a/runs/**/*.jpg
task_a/runs/**/*.jpeg
task_a/runs/**/*.svg
task_a/runs/**/*.pdf

# Model weights anywhere (project convention: never commit weights)
*.pt
*.pth
*.ckpt
*.safetensors
*.onnx
*.h5

# NOTE: task_a/runs/ keeps its small result metadata (config.json, metrics.csv,
# summaries); its images and weights are excluded above. task_a/runs_final/
# keeps its small deliverables including curves.png; only weights are excluded.

